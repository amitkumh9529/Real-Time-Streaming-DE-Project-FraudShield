# ==============================================================================
# FraudShield Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the actual .env file into version control.
# ==============================================================================

# Confluent Cloud Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxx.region.gcp.confluent.cloud:9092
KAFKA_TOPIC=credit_card_transactions
KAFKA_API_KEY=your_confluent_api_key_here
KAFKA_API_SECRET=your_confluent_api_secret_here

# Simulator Settings
TRANSACTIONS_PER_SECOND=5
FRAUD_PERCENTAGE=0.08
TOTAL_CUSTOMERS=1000
TOTAL_MERCHANTS=200
RANDOM_SEED=42

# PCI-DSS Tokenization Salt (Keep secret, rotate regularly)
CARD_TOKEN_SALT=change-me-to-a-secure-random-salt-in-production

# Email & Alert Outbox Settings (SMTP / SendGrid)
ALERT_EMAIL_FROM=alerts-noreply@yourdomain.com
ALERT_EMAIL_TO=operations-triage@yourdomain.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Databricks Deployment & Secret Scope
DATABRICKS_HOST=https://your-databricks-instance.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_pat_token_here
SECRET_SCOPE_NAME=fraudshield-scope
ENVIRONMENT=dev
TARGET_CATALOG=fraudshield
TARGET_SCHEMA=gold
