# Confluent Cloud Kafka Configuration
BOOTSTRAP_SERVERS=pkc-xxxx.region.gcp.confluent.cloud:9092
API_KEY=your_confluent_api_key
API_SECRET=your_confluent_api_secret
TOPIC_NAME=credit_card_transactions

# Simulator Performance Configuration
TRANSACTIONS_PER_SECOND=5
FRAUD_PERCENTAGE=0.08
TOTAL_CUSTOMERS=1000
TOTAL_MERCHANTS=200
RANDOM_SEED=42

# PCI-DSS Tokenization Salt
CARD_TOKEN_SALT=change-me-to-a-secure-random-salt-in-production
